# Supabase Client Configuration (Public / Browser-safe)
# Copy this file to .env and fill in your Supabase project details.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Optional Seed Script Configuration (Server / CLI only — NEVER prefix with VITE_!)
# Only needed when running scripts/seed-legacy-chapters.ts locally.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_USER_EMAIL=admin@example.com
